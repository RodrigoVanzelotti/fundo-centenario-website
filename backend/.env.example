# Desenvolvimento local. Firestore e Scheduler são configurados pela pipeline.
APP_ENV=development
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000

# Stripe: chave de teste e segredo fornecido por stripe listen. Nunca versionar credenciais.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive

# Email opcional. Preencha os quatro campos abaixo antes de habilitar.
# Padrão SMTP: STARTTLS na porta 587; demais opções estão no README.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# Cloud Run: configuradas pelo workflow, não copie segredos de produção para .env.
# APP_ENV=staging ou production; STORAGE_BACKEND=firestore; SERVE_FRONTEND=false
# GOOGLE_CLOUD_PROJECT=ID_DO_PROJETO_DESTE_AMBIENTE
# FIRESTORE_DATABASE=(default)
# FIRESTORE_PREFIX=fundo_
# PUBLIC_BASE_URL=https://ID_STAGING.web.app (produção: https://fundocentenario.com.br)
# CORS_ORIGINS deve ser exatamente PUBLIC_BASE_URL.
# PYTHON_DOTENV_DISABLED=1
# SCHEDULER_AUDIENCE=https://URL_NATIVA_CLOUD_RUN
# SCHEDULER_SERVICE_ACCOUNT=fundo-scheduler@ID_DO_PROJETO.iam.gserviceaccount.com
# INTENT_LIMIT_PER_MINUTE=60
# EMAIL_BATCH_SIZE=10
# PENDING_TTL_SECONDS=2592000
# PORT é injetada pelo Cloud Run; container aceita qualquer porta configurada.
# SMTP_PORT=587; SMTP_SECURITY=starttls; EMAIL_REPLY_TO opcional.
# Personalizações de email e defaults completos: backend/app/config.py e README.md.
