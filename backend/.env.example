# Aplicação
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
SERVE_FRONTEND=true
CORS_ORIGINS=http://localhost:8000
DATA_DIR=./backend/data
STORAGE_BACKEND=local
# Firestore usa Application Default Credentials no backend; nunca chave no frontend.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_PREFIX=fundo_
INTENT_LIMIT_PER_MINUTE=60
PENDING_TTL_SECONDS=2592000

# Use "mock" para testar o fluxo inteiro localmente.
# Use "stripe" para Checkout e contribuições mensais; "generic_http" para outro PSP.
PAYMENT_PROVIDER=mock
ENABLE_MOCK_PSP=true
MOCK_PIX_KEY=doacoes@fundocentenario.org.br
MOCK_MERCHANT_NAME=FUNDO CENTENARIO
MOCK_MERCHANT_CITY=PORTO ALEGRE

# Stripe: nunca copie chaves para o frontend. Mantenha mock até configurar o endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_LIVE_MODE=false

# ==============================================================
# PSP REAL: TODAS AS CREDENCIAIS ABAIXO FICAM SOMENTE NO BACKEND
# ============================================================== 
PSP_BASE_URL=https://api.seu-psp.com
PSP_PIX_CREATE_PATH=/pix/payments
PSP_PIX_AUTOMATIC_CREATE_PATH=/pix/automatic/authorizations
PSP_CARD_CHECKOUT_PATH=/checkout/sessions
PSP_STATUS_PATH_TEMPLATE=/payments/{provider_payment_id}

# Autenticação. Opções: none, api_key, bearer, oauth_client_credentials
PSP_AUTH_MODE=oauth_client_credentials
PSP_API_KEY=
PSP_API_KEY_HEADER=X-API-Key
PSP_BEARER_TOKEN=
PSP_OAUTH_TOKEN_URL=https://api.seu-psp.com/oauth/token
PSP_CLIENT_ID=
PSP_CLIENT_SECRET=
PSP_OAUTH_SCOPE=

# Envie nome/e-mail/CPF ao PSP somente se a API escolhida realmente exigir.
PSP_SEND_CUSTOMER_DATA=false

# Webhook. O adapter generic_http usa HMAC-SHA256.
# Se seu PSP assinar de outra forma, adapte providers/generic_http.py.
PSP_WEBHOOK_SECRET=
PSP_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Mapeamento de resposta da criação de pagamento.
PSP_FIELD_PAYMENT_ID=id
PSP_FIELD_STATUS=status
PSP_FIELD_PIX_COPY_PASTE=pix.copy_paste
PSP_FIELD_PIX_QR_BASE64=pix.qr_base64
PSP_FIELD_REDIRECT_URL=redirect_url
PSP_FIELD_EXPIRES_AT=expires_at

# Mapeamento de webhook.
# O PSP precisa devolver a referência externa/metadata enviada na criação.
PSP_WEBHOOK_FIELD_EVENT_ID=event_id
PSP_WEBHOOK_FIELD_PAYMENT_ID=payment_id
PSP_WEBHOOK_FIELD_DONATION_ID=metadata.donation_id
PSP_WEBHOOK_FIELD_STATUS=status
PSP_WEBHOOK_FIELD_AMOUNT_CENTS=amount_cents
PSP_WEBHOOK_FIELD_TOKEN_HASH=metadata.status_token_hash
PSP_WEBHOOK_FIELD_PROGRAM=metadata.program
PSP_WEBHOOK_FIELD_METHOD=metadata.method

PSP_PAID_STATUSES=paid,confirmed,approved,completed
PSP_AUTHORIZED_STATUSES=authorized,active
PSP_FAILED_STATUSES=failed,rejected,cancelled,canceled,expired


# Agradecimento por email: preencha o remetente e habilite somente depois de configurar.
EMAIL_ENABLED=false
EMAIL_BATCH_SIZE=10
# Audience: URL HTTPS do serviço Cloud Run; identidade do job do Cloud Scheduler.
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (normalmente 587) ou ssl (normalmente 465). Sem envio em texto aberto.
SMTP_SECURITY=starttls
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Fundo Centenário"
EMAIL_REPLY_TO=
EMAIL_SUBJECT="Obrigado por apoiar o Fundo Centenário"
# Vazio usa backend/templates/donation_thank_you.html.
EMAIL_TEMPLATE_PATH=
# Vazio usa PUBLIC_BASE_URL/#impacto. Use a URL pública em produção.
EMAIL_ACTIVITY_URL=
# Vazio não recomendado: este texto é inserido no HTML e na versão simples.
EMAIL_THANK_YOU_TEXT="Seu apoio transforma recursos em oportunidades para estudantes e projetos da Escola de Engenharia. Conheça as atividades do Fundo e acompanhe as histórias que a sua contribuição ajuda a construir."
